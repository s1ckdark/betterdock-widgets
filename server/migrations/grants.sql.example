-- Run as database owner after migration. Replace betterdock_market_app with the
-- pre-provisioned LOGIN role. The API never needs CREATE, TRUNCATE or ownership.
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT CONNECT ON DATABASE betterdock_market TO betterdock_market_app;
GRANT USAGE ON SCHEMA public TO betterdock_market_app;
GRANT SELECT, INSERT ON market_installations, market_downloads, market_catalog_versions TO betterdock_market_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON market_reviews TO betterdock_market_app;
